{
  "name": "socketio-chat",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "server": "npm run start",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{vue,css}\"",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"*.{js,ts}\"",
    "start": "tsx --tsconfig tsconfig.server.json server/index.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.11.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12"
  }
}
